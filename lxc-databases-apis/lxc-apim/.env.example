PORT=3100

# 'local' | 'production' — controls whether the catalog shows localhost links
# or the real seeded production URLs. Left as 'local' for dev; the eventual
# Build to Publish flow sets this to 'production' when packaging for Hostinger.
APIM_ENV=local

# Shared Hostinger MySQL connection — same database as lxc-api, separated by
# table prefix (api_* / apim_*). See ../lxc-api/DB_CONNECTION.md.
MYSQL_HOST=srv1878.hstgr.io
MYSQL_PORT=3306
MYSQL_DATABASE=u450600831_lxc_hlthapi_db
MYSQL_USER=u450600831_lxc_hapi_admin
MYSQL_PASSWORD=your_mysql_password_here

# JWT signing — used by the product-aware auth API (POST /v1/auth/login).
# Generate a long random value for production; never commit the real value.
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1h

# Optional — only needed to override the admin backdoor default
# (admin/admin@1234) the first time db:seed:admin creates that row. Leave
# unset to use the default; superadmin/superadmin@#$1234 is always seeded
# separately regardless (see scripts/seed-admin.mjs).
#SEED_ADMIN_EMAIL=admin@lexvoraconsulting.com
#SEED_ADMIN_PASSWORD=change_me_before_running
