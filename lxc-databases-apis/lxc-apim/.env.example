PORT=3100

# Shared Hostinger MySQL connection — same database as lxc-api, separated by
# table prefix (api_* / apim_*). See ../lxc-api/DB_CONNECTION.md.
MYSQL_HOST=srv1878.hstgr.io
MYSQL_PORT=3306
MYSQL_DATABASE=u450600831_lxc_hlthapi_db
MYSQL_USER=u450600831_lxc_hapi_admin
MYSQL_PASSWORD=your_mysql_password_here

# JWT signing — used by the product-aware auth API (POST /v1/auth/login).
# Generate a long random value for production; never commit the real value.
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1h

# Used only by `npm run db:seed:admin` to create/update the default admin user.
SEED_ADMIN_EMAIL=admin@lexvoraconsulting.com
SEED_ADMIN_PASSWORD=change_me_before_running
