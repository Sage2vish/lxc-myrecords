<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LXC APIM — Change Password</title>
  <link rel="stylesheet" href="/css/theme.css" />
</head>
<body>
  <%- include('partials/nav', {session: typeof session !== 'undefined' ? session : null}) %>

  <main class="page-narrow">
    <div class="form-card">
      <h1>Change Password</h1>
      <p class="form-sub">Set a real password for the <code>admin</code> account.</p>

      <% if (error) { %>
        <div class="form-error"><%= error %></div>
      <% } %>

      <% if (canSubmit) { %>
        <form method="POST" action="/change-password">
          <div class="form-field">
            <label for="newPassword">New Password</label>
            <input type="password" id="newPassword" name="newPassword" autocomplete="new-password" required minlength="8" />
          </div>
          <div class="form-field">
            <label for="confirmPassword">Confirm Password</label>
            <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required minlength="8" />
          </div>
          <button type="submit" class="btn">Change Password</button>
        </form>
        <p class="form-note">Changing this also disables the superadmin recovery account — it can be re-enabled directly in MySQL if ever needed.</p>
      <% } %>
    </div>
  </main>

  <footer class="site-footer">
    <p>&copy; 2026 Lexvora Consulting</p>
  </footer>
</body>
</html>
