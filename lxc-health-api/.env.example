PORT=3000
DEFAULT_WEATHER_CITY=Dubai

# Optional: only needed if you later automate Hostinger API actions from this project.
# Keep the real values out of git and put them in local .env or Hostinger environment settings.
HOSTINGER_API_TOKEN=your_hostinger_api_token_here
HOSTINGER_APP_ID=your_hostinger_app_id_here

# Weather API registry
WEATHER_WEATHERAPI_FORECASTV1_BASE_URL=https://api.weatherapi.com/v1
WEATHER_WEATHERAPI_FORECASTV1_API_KEY=your_weatherapi_key_here
